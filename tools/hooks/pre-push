#!/bin/bash
# NeoMind pre-push PII guard — second-layer protection at the public boundary.
# Blocks a push whose outgoing commits contain the owner's private/financial
# data (real holdings, identity, home path, bot handle).
#
# Reads ref updates on stdin:  <local_ref> <local_sha> <remote_ref> <remote_sha>
# Bypass:  NEOMIND_ALLOW_PERSONAL=1 git push ...
#
# Install (one-time per clone):  ./tools/hooks/install.sh

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCAN="$REPO_ROOT/tools/hooks/scan_staged_pii.py"
[ -f "$SCAN" ] || exit 0

ZERO="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # branch deletion — nothing to scan
    [ "$local_sha" = "$ZERO" ] && continue

    if [ "$remote_sha" = "$ZERO" ]; then
        # new branch on the remote: scan commits not already on origin/main
        base="$(git merge-base "$local_sha" origin/main 2>/dev/null)"
        if [ -n "$base" ]; then
            range="$base..$local_sha"
        else
            range="$local_sha"   # no common base — scan the branch tip diff
        fi
    else
        range="$remote_sha..$local_sha"
    fi

    if ! python3 "$SCAN" diff "$range"; then
        status=1
    fi
done

exit $status
